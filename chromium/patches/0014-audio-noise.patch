+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_WEBAUDIO_MOLTSKIN_AUDIO_NOISE_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_WEBAUDIO_MOLTSKIN_AUDIO_NOISE_H_
+
+#include <algorithm>
+#include <cstdint>
+
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "base/strings/string_number_conversions.h"
+#include "third_party/blink/public/common/moltskin_switches.h"
+
+namespace blink {
+
+inline uint32_t GetMoltskinAudioNoiseSeed() {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(switches::kMoltskinAudioNoise)) {
+    return 0;
+  }
+  uint32_t seed = 0;
+  if (!base::StringToUint(
+          command_line->GetSwitchValueASCII(switches::kMoltskinAudioNoise),
+          &seed)) {
+    return 0;
+  }
+  return seed;
+}
+
+inline uint32_t MoltskinAudioNoiseMix(uint32_t value) {
+  value ^= value >> 16;
+  value *= 0x7feb352dU;
+  value ^= value >> 15;
+  value *= 0x846ca68bU;
+  value ^= value >> 16;
+  return value;
+}
+
+// A -80 dBFS perturbation is inaudible but changes float samples and quantized
+// fingerprint hashes.
+inline float MoltskinAudioNoiseDelta(uint32_t hash) {
+  constexpr float kAmplitude = 1.0e-4f;
+  return static_cast<float>(static_cast<int>(hash % 3U) - 1) * kAmplitude;
+}
+
+inline void AddMoltskinAudioNoise(base::span<float> samples,
+                                  unsigned channel_index) {
+  const uint32_t seed = GetMoltskinAudioNoiseSeed();
+  if (seed == 0) {
+    return;
+  }
+  for (size_t i = 0; i < samples.size(); ++i) {
+    const uint32_t hash = MoltskinAudioNoiseMix(
+        seed ^ (static_cast<uint32_t>(i) * 0x9e3779b1U) ^
+        (channel_index * 0x85ebca77U));
+    samples[i] = std::clamp(samples[i] + MoltskinAudioNoiseDelta(hash), -1.0f,
+                            1.0f);
+  }
+}
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_WEBAUDIO_MOLTSKIN_AUDIO_NOISE_H_
