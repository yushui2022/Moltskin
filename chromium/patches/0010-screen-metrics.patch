+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_MOLTSKIN_SCREEN_METRICS_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_MOLTSKIN_SCREEN_METRICS_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "third_party/blink/public/common/moltskin_switches.h"
+#include "ui/display/screen_info.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace blink {
+
+struct MoltskinScreenMetrics {
+  int width = 0;
+  int height = 0;
+  int depth = 24;
+  double device_scale_factor = 1.0;
+};
+
+inline std::optional<MoltskinScreenMetrics> GetMoltskinScreenMetrics() {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(switches::kMoltskinScreenMetrics)) {
+    return std::nullopt;
+  }
+  const std::string value =
+      command_line->GetSwitchValueASCII(switches::kMoltskinScreenMetrics);
+  const size_t at = value.find('@');
+  if (at == std::string::npos) {
+    return std::nullopt;
+  }
+  const std::vector<std::string> parts = base::SplitString(
+      value.substr(0, at), "x", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+  if (parts.size() != 3) {
+    return std::nullopt;
+  }
+  MoltskinScreenMetrics metrics;
+  if (!base::StringToInt(parts[0], &metrics.width) ||
+      !base::StringToInt(parts[1], &metrics.height) ||
+      !base::StringToInt(parts[2], &metrics.depth) ||
+      !base::StringToDouble(value.substr(at + 1),
+                            &metrics.device_scale_factor)) {
+    return std::nullopt;
+  }
+  if (metrics.width < 320 || metrics.width > 10000 || metrics.height < 240 ||
+      metrics.height > 10000 || metrics.depth < 16 || metrics.depth > 32 ||
+      metrics.device_scale_factor < 0.5 ||
+      metrics.device_scale_factor > 4.0) {
+    return std::nullopt;
+  }
+  return metrics;
+}
+
+inline void ApplyMoltskinScreenMetrics(display::ScreenInfo* screen_info) {
+  const std::optional<MoltskinScreenMetrics> metrics =
+      GetMoltskinScreenMetrics();
+  if (!metrics) {
+    return;
+  }
+  screen_info->rect = gfx::Rect(0, 0, metrics->width, metrics->height);
+  screen_info->available_rect = screen_info->rect;
+  screen_info->depth = metrics->depth;
+  screen_info->depth_per_component = 8;
+  screen_info->is_monochrome = false;
+  screen_info->device_scale_factor = metrics->device_scale_factor;
+}
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_MOLTSKIN_SCREEN_METRICS_H_
