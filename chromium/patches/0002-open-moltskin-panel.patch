 }  // namespace
 
+void ResolveMoltskinPanelURL(GURL* url) {
+  if (!url->is_valid() || url->spec() != kMoltskinPanelURL) {
+    return;
+  }
+  unsigned port = 8765;
+  const auto* command_line = base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch("moltskin-panel-port")) {
+    const auto value = command_line->GetSwitchValueASCII("moltskin-panel-port");
+    if (!base::ContainsOnlyChars(value, "0123456789") ||
+        !base::StringToUint(value, &port) || port == 0 || port > 65535) {
+      return;
+    }
+  }
+  *url = GURL("http://127.0.0.1:" + base::NumberToString(port) + "/");
+}
