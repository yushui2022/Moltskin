+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_MOLTSKIN_WEBGL_PARAMS_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_MOLTSKIN_WEBGL_PARAMS_H_
+
+#include <array>
+#include <optional>
+
+#include "base/command_line.h"
+#include "third_party/angle/include/GLES2/gl2.h"
+#include "third_party/angle/include/GLES2/gl2ext.h"
+#include "third_party/blink/public/common/moltskin_switches.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+
+namespace blink {
+
+inline bool IsMoltskinWebglProfileEnabled() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      switches::kMoltskinWebglProfile);
+}
+
+inline std::optional<int> GetMoltskinWebglIntParameter(GLenum pname) {
+  if (!IsMoltskinWebglProfileEnabled()) {
+    return std::nullopt;
+  }
+  switch (pname) {
+    case GL_MAX_TEXTURE_SIZE:
+      return 16384;
+    case GL_MAX_CUBE_MAP_TEXTURE_SIZE:
+      return 16384;
+    case GL_MAX_RENDERBUFFER_SIZE:
+      return 16384;
+    case GL_MAX_VERTEX_ATTRIBS:
+      return 16;
+    case GL_MAX_VERTEX_UNIFORM_VECTORS:
+      return 4096;
+    case GL_MAX_VARYING_VECTORS:
+      return 31;
+    case GL_MAX_COMBINED_TEXTURE_IMAGE_UNITS:
+      return 32;
+    case GL_MAX_VERTEX_TEXTURE_IMAGE_UNITS:
+      return 32;
+    case GL_MAX_TEXTURE_IMAGE_UNITS:
+      return 16;
+    case GL_MAX_FRAGMENT_UNIFORM_VECTORS:
+      return 4096;
+    case GL_MAX_TEXTURE_MAX_ANISOTROPY_EXT:
+      return 16;
+    default:
+      return std::nullopt;
+  }
+}
+
+inline std::optional<std::array<int, 2>> GetMoltskinWebglInt2Parameter(
+    GLenum pname) {
+  if (!IsMoltskinWebglProfileEnabled()) {
+    return std::nullopt;
+  }
+  if (pname == GL_MAX_VIEWPORT_DIMS) {
+    return std::array<int, 2>{32767, 32767};
+  }
+  return std::nullopt;
+}
+
+inline bool IsMoltskinWebglExtensionAllowed(const String& name) {
+  if (!IsMoltskinWebglProfileEnabled()) {
+    return true;
+  }
+  return name != "WEBGL_compressed_texture_astc" &&
+         name != "WEBGL_compressed_texture_etc" &&
+         name != "WEBGL_compressed_texture_etc1" &&
+         name != "WEBGL_compressed_texture_pvrtc";
+}
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_MOLTSKIN_WEBGL_PARAMS_H_
