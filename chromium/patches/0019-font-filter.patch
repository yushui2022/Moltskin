 namespace blink {
+
+void FontDescription::SetFamily(const FontFamily& family) {
+  if (!IsMoltskinFontFilterEnabled()) {
+    family_list_ = family;
+    return;
+  }
+
+  Vector<const FontFamily*> allowed;
+  for (const FontFamily* current = &family; current; current = current->Next()) {
+    if (current->FamilyIsGeneric() ||
+        IsMoltskinFontAllowed(current->FamilyName())) {
+      allowed.push_back(current);
+    }
+  }
+
+  if (allowed.empty()) {
+    family_list_ = FontFamily(font_family_names::kSansSerif,
+                              FontFamily::Type::kGenericFamily);
+    return;
+  }
+
+  scoped_refptr<SharedFontFamily> head;
+  for (auto current = allowed.rbegin(); current != allowed.rend(); ++current) {
+    const FontFamily* source = *current;
+    head = SharedFontFamily::Create(
+        source->FamilyName(),
+        source->FamilyIsGeneric() ? FontFamily::Type::kGenericFamily
+                                  : FontFamily::Type::kFamilyName,
+        std::move(head));
+  }
+  family_list_ = FontFamily(
+      head->FamilyName(),
+      head->FamilyIsGeneric() ? FontFamily::Type::kGenericFamily
+                              : FontFamily::Type::kFamilyName,
+      head->ReleaseNext());
+}
 
