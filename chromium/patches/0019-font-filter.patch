+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_MOLTSKIN_FONT_FILTER_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_MOLTSKIN_FONT_FILTER_H_
+
+#include "base/command_line.h"
+#include "third_party/blink/public/common/moltskin_switches.h"
+#include "third_party/blink/renderer/platform/font_family_names.h"
+#include "third_party/blink/renderer/platform/wtf/text/atomic_string.h"
+
+namespace blink {
+
+inline bool IsMoltskinFontFilterEnabled() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      switches::kMoltskinFontFilter);
+}
+
+inline bool IsMoltskinFontAllowed(const AtomicString& family) {
+  if (family.empty()) {
+    return true;
+  }
+  if (family == font_family_names::kSerif ||
+      family == font_family_names::kSansSerif ||
+      family == font_family_names::kMonospace ||
+      family == font_family_names::kCursive ||
+      family == font_family_names::kFantasy ||
+      family == font_family_names::kSystemUi ||
+      family == font_family_names::kBlinkMacSystemFont ||
+      family == font_family_names::kWebkitStandard) {
+    return true;
+  }
+
+  // Cross-platform desktop families. macOS-only families such as Helvetica,
+  // Futura, PingFang, Geneva and Apple SD Gothic Neo remain filtered out.
+  for (const char* allowed :
+       {"Arial", "Arial Black", "Comic Sans MS", "Courier New", "Georgia",
+        "Impact", "Times New Roman", "Trebuchet MS", "Verdana", "Webdings",
+        "Wingdings", "Tahoma", "Microsoft Sans Serif", "Lucida Console",
+        "Palatino Linotype", "emoji", "ui-serif", "ui-sans-serif",
+        "ui-monospace", "ui-rounded"}) {
+    if (EqualIgnoringAsciiCase(family, allowed)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_MOLTSKIN_FONT_FILTER_H_
