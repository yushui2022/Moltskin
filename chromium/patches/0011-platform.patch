+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_PUBLIC_COMMON_MOLTSKIN_PLATFORM_H_
+#define THIRD_PARTY_BLINK_PUBLIC_COMMON_MOLTSKIN_PLATFORM_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/strings/string_split.h"
+#include "third_party/blink/public/common/moltskin_switches.h"
+
+namespace blink {
+
+struct MoltskinPlatform {
+  std::string platform;          // windows, macos, linux
+  std::string platform_version;  // e.g. 10.0.0
+  std::string architecture;      // x86_64 or arm64
+};
+
+inline std::optional<MoltskinPlatform> GetMoltskinPlatform() {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(switches::kMoltskinPlatform)) {
+    return std::nullopt;
+  }
+  const std::string value =
+      command_line->GetSwitchValueASCII(switches::kMoltskinPlatform);
+  const std::vector<std::string> parts =
+      base::SplitString(value, ":", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+  if (parts.size() != 3) {
+    return std::nullopt;
+  }
+  MoltskinPlatform result{parts[0], parts[1], parts[2]};
+  if (result.platform != "windows" && result.platform != "macos" &&
+      result.platform != "linux") {
+    return std::nullopt;
+  }
+  if (result.architecture != "x86_64" && result.architecture != "arm64") {
+    return std::nullopt;
+  }
+  return result;
+}
+
+inline std::string MoltskinUaPlatform(const MoltskinPlatform& platform) {
+  if (platform.platform == "windows") {
+    return "Windows";
+  }
+  if (platform.platform == "macos") {
+    return "macOS";
+  }
+  return "Linux";
+}
+
+inline std::string MoltskinNavigatorPlatform(const MoltskinPlatform& platform) {
+  if (platform.platform == "windows") {
+    return "Win32";
+  }
+  if (platform.platform == "macos") {
+    return "MacIntel";
+  }
+  return platform.architecture == "arm64" ? "Linux armv8l" : "Linux x86_64";
+}
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_PUBLIC_COMMON_MOLTSKIN_PLATFORM_H_
