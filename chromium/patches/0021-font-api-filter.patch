+inline bool MoltskinFontStringRequestsOnlyDisallowedFamilies(
+    const String& font_string) {
+  if (!IsMoltskinFontFilterEnabled()) {
+    return false;
+  }
+  bool found_family = false;
+  for (unsigned i = 0; i < font_string.length(); ++i) {
+    const UChar quote = font_string[i];
+    if (quote != '"' && quote != '\'') {
+      continue;
+    }
+    unsigned end = i + 1;
+    while (end < font_string.length() && font_string[end] != quote) {
+      ++end;
+    }
+    if (end >= font_string.length()) {
+      break;
+    }
+    found_family = true;
+    if (IsMoltskinFontAllowed(
+            AtomicString(font_string.subview(i + 1, end - i - 1)))) {
+      return false;
+    }
+    i = end;
+  }
+  return found_family;
+}
