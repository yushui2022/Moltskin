 bool Navigator::webdriver() const {
+  // Moltskin profiles must not expose the automation-controlled flag even
+  // when a client launched the browser with CDP/Playwright enabled.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          switches::kMoltskinHideWebdriver)) {
+    return false;
+  }
+
   if (RuntimeEnabledFeatures::AutomationControlledEnabled())
     return true;
 
