+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_MOLTSKIN_CANVAS_NOISE_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_MOLTSKIN_CANVAS_NOISE_H_
+
+#include <cstdint>
+
+#include "base/command_line.h"
+#include "base/compiler_specific.h"
+#include "base/containers/span.h"
+#include "base/strings/string_number_conversions.h"
+#include "third_party/blink/public/common/moltskin_switches.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+
+namespace blink {
+
+inline uint32_t GetMoltskinCanvasNoiseSeed() {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(switches::kMoltskinCanvasNoise)) {
+    return 0;
+  }
+  uint32_t seed = 0;
+  if (!base::StringToUint(
+          command_line->GetSwitchValueASCII(switches::kMoltskinCanvasNoise),
+          &seed)) {
+    return 0;
+  }
+  return seed;
+}
+
+inline uint32_t MoltskinCanvasNoiseMix(uint32_t value) {
+  value ^= value >> 16;
+  value *= 0x7feb352dU;
+  value ^= value >> 15;
+  value *= 0x846ca68bU;
+  value ^= value >> 16;
+  return value;
+}
+
+inline int MoltskinCanvasNoiseDelta(uint32_t hash) {
+  return static_cast<int>(hash % 3U) - 1;
+}
+
+// Adds deterministic +/-1 noise to the color channels of an 8-bit RGBA/BGRA
+// pixmap. Alpha is left untouched. Origin lets cropped readbacks keep the same
+// per-pixel pattern as a full-canvas readback.
+inline void ApplyMoltskinCanvasNoise(SkPixmap* pixmap,
+                                     int origin_x = 0,
+                                     int origin_y = 0) {
+  const uint32_t seed = GetMoltskinCanvasNoiseSeed();
+  if (seed == 0 || pixmap == nullptr) {
+    return;
+  }
+  if (pixmap->colorType() != kRGBA_8888_SkColorType &&
+      pixmap->colorType() != kBGRA_8888_SkColorType) {
+    return;
+  }
+  if (pixmap->info().bytesPerPixel() != 4 || pixmap->rowBytes() < 4) {
+    return;
+  }
+
+  uint8_t* pixels = static_cast<uint8_t*>(pixmap->writable_addr());
+  const bool premultiplied =
+      pixmap->alphaType() == kPremul_SkAlphaType;
+  if (pixels == nullptr) {
+    return;
+  }
+  base::span<uint8_t> bytes = UNSAFE_BUFFERS(
+      base::span(pixels, pixmap->computeByteSize()));
+  const size_t row_bytes = pixmap->rowBytes();
+
+  for (int y = 0; y < pixmap->height(); ++y) {
+    base::span<uint8_t> row = bytes.subspan(static_cast<size_t>(y) * row_bytes,
+                                            row_bytes);
+    const uint32_t absolute_y = static_cast<uint32_t>(origin_y + y);
+    for (int x = 0; x < pixmap->width(); ++x) {
+      base::span<uint8_t> pixel = row.subspan(static_cast<size_t>(x) * 4, size_t{4});
+      if (pixel[3] == 0) {
+        continue;
+      }
+      const uint32_t absolute_x = static_cast<uint32_t>(origin_x + x);
+      const uint32_t hash = MoltskinCanvasNoiseMix(
+          seed ^ (absolute_x * 0x9e3779b1U) ^ (absolute_y * 0x85ebca77U));
+      const int delta_r = MoltskinCanvasNoiseDelta(hash);
+      const int delta_g = MoltskinCanvasNoiseDelta(hash >> 8);
+      const int delta_b = MoltskinCanvasNoiseDelta(hash >> 16);
+      const int alpha = pixel[3];
+      int r = pixel[0] + delta_r;
+      int g = pixel[1] + delta_g;
+      int b = pixel[2] + delta_b;
+      r = r < 0 ? 0 : (r > 255 ? 255 : r);
+      g = g < 0 ? 0 : (g > 255 ? 255 : g);
+      b = b < 0 ? 0 : (b > 255 ? 255 : b);
+      if (premultiplied) {
+        r = r > alpha ? alpha : r;
+        g = g > alpha ? alpha : g;
+        b = b > alpha ? alpha : b;
+      }
+      pixel[0] = static_cast<uint8_t>(r);
+      pixel[1] = static_cast<uint8_t>(g);
+      pixel[2] = static_cast<uint8_t>(b);
+    }
+  }
+}
