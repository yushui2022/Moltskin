+void ImageDataBuffer::ApplyCanvasNoise() {
+  if (!is_valid_ || GetMoltskinCanvasNoiseSeed() == 0) {
+    return;
+  }
+  const SkImageInfo& info = pixmap_.info();
+  if ((info.colorType() != kRGBA_8888_SkColorType &&
+       info.colorType() != kBGRA_8888_SkColorType) ||
+      info.bytesPerPixel() != 4 || info.isEmpty()) {
+    return;
+  }
+
+  const size_t size = pixmap_.computeByteSize();
+  if (size == 0) {
+    return;
+  }
+  sk_sp<SkData> data = SkData::MakeUninitialized(size);
+  if (!data) {
+    return;
+  }
+  SkPixmap noisy(info, data->writable_data(), pixmap_.rowBytes());
+  base::span<uint8_t> noisy_bytes = UNSAFE_BUFFERS(base::span(
+      static_cast<uint8_t*>(noisy.writable_addr()), size));
+  base::span<const uint8_t> source = UNSAFE_BUFFERS(base::span(
+      static_cast<const uint8_t*>(pixmap_.addr()), size));
+  for (int y = 0; y < info.height(); ++y) {
+    const size_t row_start = static_cast<size_t>(y) * pixmap_.rowBytes();
+    noisy_bytes.subspan(row_start, pixmap_.rowBytes())
+        .copy_from(source.subspan(row_start, pixmap_.rowBytes()));
+  }
+  ApplyMoltskinCanvasNoise(&noisy);
+
+  sk_sp<SkImage> image =
+      SkImages::RasterFromData(info, std::move(data), pixmap_.rowBytes());
+  if (!image || !image->peekPixels(&pixmap_)) {
+    is_valid_ = false;
+    return;
+  }
+  retained_image_ = std::move(image);
+}
