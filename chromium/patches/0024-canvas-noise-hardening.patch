+static bool MoltskinFillRectIsUniform(
+    const CanvasRenderingContext2DState& state,
+    const gfx::RectF& rect) {
+  // Known-pixel probes use an opaque solid colour, the default composite and
+  // an axis-aligned integer rectangle. Leave those pixels untouched so the
+  // readback still equals a clean browser's readback.
+  if (!state.FillStyle().IsOpaqueColor() ||
+      state.FillStyle().GetCanvasGradient() != nullptr ||
+      state.FillStyle().GetCanvasPattern() != nullptr) {
+    return false;
+  }
+  if (state.ShadowBlur() > 0 || !state.ShadowOffset().IsZero() ||
+      state.IsFilterResolved() || state.IsFilterUnresolved() ||
+      state.GlobalAlpha() < 1.0 ||
+      state.GlobalComposite() != SkBlendMode::kSrcOver) {
+    return false;
+  }
+  const AffineTransform& transform = state.GetTransform();
+  if (transform.B() != 0 || transform.C() != 0 ||
+      std::floor(transform.A()) != transform.A() ||
+      std::floor(transform.D()) != transform.D()) {
+    return false;
+  }
+  const gfx::RectF mapped = transform.MapRect(rect);
+  auto is_integral = [](float value) { return std::floor(value) == value; };
+  return is_integral(mapped.x()) && is_integral(mapped.y()) &&
+         is_integral(mapped.width()) && is_integral(mapped.height());
+}
