+void ApplyMoltskinBrand(blink::UserAgentBrandList& list,
+                        const std::string& version,
+                        bool full_version) {
+  const std::optional<blink::MoltskinBrand> brand =
+      blink::GetMoltskinBrand();
+  if (!brand) {
+    return;
+  }
+  bool has_chromium = false;
+  bool has_google = false;
+  for (auto& entry : list) {
+    if (entry.brand == "Chromium") {
+      entry.version = version;
+      has_chromium = true;
+    }
+    if (entry.brand == "Google Chrome") {
+      entry.version = version;
+      has_google = true;
+    }
+  }
+  if (!has_chromium) {
+    list.emplace_back("Chromium", version);
+  }
+  if (!has_google) {
+    list.emplace_back("Google Chrome", version);
+  }
+}
