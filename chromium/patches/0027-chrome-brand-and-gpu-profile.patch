+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_PUBLIC_COMMON_MOLTSKIN_BRAND_H_
+#define THIRD_PARTY_BLINK_PUBLIC_COMMON_MOLTSKIN_BRAND_H_
+
+#include <optional>
+#include <string>
+
+#include "base/command_line.h"
+#include "third_party/blink/public/common/moltskin_switches.h"
+
+namespace blink {
+
+struct MoltskinBrand {
+  std::string brand;       // chrome
+  std::string version;     // reduced UA version, e.g. 158.0.0.0
+  std::string full_version;  // full build version, e.g. 158.0.8127.88
+};
+
+inline std::optional<MoltskinBrand> GetMoltskinBrand() {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(switches::kMoltskinBrand)) {
+    return std::nullopt;
+  }
+  const std::string brand =
+      command_line->GetSwitchValueASCII(switches::kMoltskinBrand);
+  const std::string version =
+      command_line->GetSwitchValueASCII(switches::kMoltskinBrandVersion);
+  std::string full_version = command_line->GetSwitchValueASCII(
+      switches::kMoltskinBrandFullVersion);
+  if (full_version.empty()) {
+    full_version = version;
+  }
+  if (brand != "chrome" || version.empty() || version.size() > 32 ||
+      full_version.size() > 32) {
+    return std::nullopt;
+  }
+  for (char ch : version) {
+    if ((ch < '0' || ch > '9') && ch != '.') {
+      return std::nullopt;
+    }
+  }
+  for (char ch : full_version) {
+    if ((ch < '0' || ch > '9') && ch != '.') {
+      return std::nullopt;
+    }
+  }
+  return MoltskinBrand{brand, version, full_version};
+}
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_PUBLIC_COMMON_MOLTSKIN_BRAND_H_
