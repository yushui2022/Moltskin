+inline std::optional<std::array<float, 2>> GetMoltskinWebglFloat2Parameter(
+    GLenum pname) {
+  if (!IsMoltskinWebglProfileEnabled()) {
+    return std::nullopt;
+  }
+  if (pname == GL_ALIASED_LINE_WIDTH_RANGE) {
+    return std::array<float, 2>{1.0f, 1.0f};
+  }
+  if (pname == GL_ALIASED_POINT_SIZE_RANGE) {
+    return std::array<float, 2>{1.0f, 1024.0f};
+  }
+  return std::nullopt;
+}
+
+inline std::optional<std::array<GLint, 3>> GetMoltskinShaderPrecision(
+    GLenum precision_type) {
+  if (!IsMoltskinWebglProfileEnabled()) {
+    return std::nullopt;
+  }
+  switch (precision_type) {
+    case GL_LOW_FLOAT:
+    case GL_MEDIUM_FLOAT:
+      return std::array<GLint, 3>{15, 15, 10};
+    case GL_HIGH_FLOAT:
+      return std::array<GLint, 3>{127, 127, 23};
+    case GL_LOW_INT:
+    case GL_MEDIUM_INT:
+    case GL_HIGH_INT:
+      return std::array<GLint, 3>{31, 31, 0};
+    default:
+      return std::nullopt;
+  }
+}
