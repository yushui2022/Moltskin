+#define THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGPU_MOLTSKIN_WEBGPU_H_
+
+#include <optional>
+#include <string>
+
+#include "base/command_line.h"
+#include "third_party/blink/public/common/moltskin_switches.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+
+namespace blink {
+
+inline std::optional<String> GetMoltskinWebgpuValue(const char* switch_name) {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(switch_name)) {
+    return std::nullopt;
+  }
+  const std::string value = command_line->GetSwitchValueASCII(switch_name);
+  if (value.empty() || value.size() > 256) {
+    return std::nullopt;
+  }
+  return String::FromUtf8(std::string_view(value));
+}
+
+inline std::optional<String> GetMoltskinWebgpuVendor() {
+  return GetMoltskinWebgpuValue(switches::kMoltskinWebgpuVendor);
+}
+
+inline std::optional<String> GetMoltskinWebgpuArchitecture() {
+  return GetMoltskinWebgpuValue(switches::kMoltskinWebgpuArchitecture);
+}
+
+inline std::optional<String> GetMoltskinWebgpuDevice() {
+  return GetMoltskinWebgpuValue(switches::kMoltskinWebgpuDevice);
+}
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGPU_MOLTSKIN_WEBGPU_H_
