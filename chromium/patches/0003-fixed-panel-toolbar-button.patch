+
+void OpenMoltskinHome(BrowserWindowInterface* browser) {
+  GURL panel("chrome://moltskin/");
+  startup::ResolveMoltskinPanelURL(&panel);
+  if (!panel.SchemeIs("http")) {
+    return;
+  }
+  const GURL home = panel.Resolve("#/home");
+  NavigateParams params(browser, home, ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  params.user_gesture = true;
+  params.disposition = WindowOpenDisposition::kNewForegroundTab;
+  // Only an existing dashboard document in this window may be reused.
+  // Other pages served by the same loopback host are ordinary working tabs.
+  TabStripModel* tabs = browser->GetTabStripModel();
+  for (int i = 0; i < tabs->count(); ++i) {
+    content::WebContents* tab = tabs->GetWebContentsAt(i);
+    if (tab->GetVisibleURL().EqualsIgnoringRef(panel)) {
+      tabs->ActivateTabAt(i);
+      if (tab->GetVisibleURL() == home && !tab->IsCrashed()) {
+        return;
+      }
+      params.disposition = WindowOpenDisposition::kCurrentTab;
+      params.source_contents = tab;
+      break;
+    }
+  }
+  Navigate(&params);
+}
