 namespace blink {
 
+namespace {
+
+struct MoltskinVoiceSpec {
+  const char* name;
+};
+
+constexpr MoltskinVoiceSpec kEnglishUsVoices[] = {
+    {"Microsoft David - English (United States)"},
+    {"Microsoft Zira - English (United States)"},
+    {"Microsoft Mark - English (United States)"},
+};
+constexpr MoltskinVoiceSpec kEnglishGbVoices[] = {
+    {"Microsoft George - English (United Kingdom)"},
+    {"Microsoft Hazel - English (United Kingdom)"},
+};
+constexpr MoltskinVoiceSpec kJapaneseVoices[] = {
+    {"Microsoft Haruka - Japanese (Japan)"},
+    {"Microsoft Ichiro - Japanese (Japan)"},
+};
+constexpr MoltskinVoiceSpec kGermanVoices[] = {
+    {"Microsoft Hedda - German (Germany)"},
+    {"Microsoft Stefan - German (Germany)"},
+};
+constexpr MoltskinVoiceSpec kFrenchVoices[] = {
+    {"Microsoft Hortense - French (France)"},
+    {"Microsoft Paul - French (France)"},
+};
+constexpr MoltskinVoiceSpec kChineseVoices[] = {
+    {"Microsoft Huihui - Chinese (Simplified, PRC)"},
+    {"Microsoft Yaoyao - Chinese (Simplified, PRC)"},
+};
+
+std::optional<std::string> GetMoltskinSpeechLanguage() {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  std::string language;
+  if (command_line->HasSwitch(switches::kMoltskinSpeechVoices)) {
+    language =
+        command_line->GetSwitchValueASCII(switches::kMoltskinSpeechVoices);
+  } else if (command_line->HasSwitch(switches::kMoltskinLocale)) {
+    language = command_line->GetSwitchValueASCII(switches::kMoltskinLocale);
+  }
+  if (language.empty()) {
+    return std::nullopt;
+  }
+  return language;
+}
+
+template <size_t N>
+void AppendMoltskinSpeechVoices(
+    const MoltskinVoiceSpec (&specs)[N],
+    const std::string& language,
+    Vector<mojom::blink::SpeechSynthesisVoicePtr>* result) {
+  size_t index = 0;
+  for (const MoltskinVoiceSpec& spec : specs) {
+    auto voice = mojom::blink::SpeechSynthesisVoice::New();
+    voice->name = String::FromUtf8(spec.name);
+    voice->voice_uri = voice->name;
+    voice->lang = String::FromUtf8(language);
+    voice->is_local_service = true;
+    voice->is_default = index == 0;
+    result->push_back(std::move(voice));
+    ++index;
+  }
+}
+
+Vector<mojom::blink::SpeechSynthesisVoicePtr> BuildMoltskinSpeechVoices(
+    const std::string& language) {
+  Vector<mojom::blink::SpeechSynthesisVoicePtr> result;
+  if (language == "en-US") {
+    AppendMoltskinSpeechVoices(kEnglishUsVoices, language, &result);
+  } else if (language == "en-GB") {
+    AppendMoltskinSpeechVoices(kEnglishGbVoices, language, &result);
+  } else if (language == "ja-JP") {
+    AppendMoltskinSpeechVoices(kJapaneseVoices, language, &result);
+  } else if (language == "de-DE") {
+    AppendMoltskinSpeechVoices(kGermanVoices, language, &result);
+  } else if (language == "fr-FR") {
+    AppendMoltskinSpeechVoices(kFrenchVoices, language, &result);
+  } else if (language == "zh-CN") {
+    AppendMoltskinSpeechVoices(kChineseVoices, language, &result);
+  }
+  return result;
+}
+
+}  // namespace
+
 const char SpeechSynthesis::kSupplementName[] = "SpeechSynthesis";
 
 
