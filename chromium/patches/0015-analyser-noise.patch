+inline uint32_t MoltskinAudioNoiseHash(uint32_t seed,
+                                      size_t index,
+                                      uint32_t domain) {
+  return MoltskinAudioNoiseMix(
+      seed ^ (static_cast<uint32_t>(index) * 0x9e3779b1U) ^
+      (domain * 0x85ebca77U));
+}
+
 // A -80 dBFS perturbation is inaudible but changes float samples and quantized
 // fingerprint hashes.
 inline float MoltskinAudioNoiseDelta(uint32_t hash) {
@@ -52,14 +60,40 @@
