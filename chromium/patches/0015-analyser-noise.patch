-    const uint32_t hash = MoltskinAudioNoiseMix(
-        seed ^ (static_cast<uint32_t>(i) * 0x9e3779b1U) ^
-        (channel_index * 0x85ebca77U));
+    const uint32_t hash = MoltskinAudioNoiseHash(seed, i, channel_index);
     samples[i] = std::clamp(samples[i] + MoltskinAudioNoiseDelta(hash), -1.0f,
                             1.0f);
   }
 }
 
+inline void AddMoltskinAnalyserFloatNoise(base::span<float> values,
+                                          float amplitude) {
+  const uint32_t seed = GetMoltskinAudioNoiseSeed();
+  if (seed == 0) {
+    return;
+  }
+  for (size_t i = 0; i < values.size(); ++i) {
+    const uint32_t hash = MoltskinAudioNoiseHash(seed, i, 0x100U);
+    const float delta =
+        static_cast<float>(static_cast<int>(hash % 3U) - 1) * amplitude;
+    values[i] += delta;
+  }
+}
+
+inline void AddMoltskinAnalyserByteNoise(base::span<unsigned char> values) {
+  const uint32_t seed = GetMoltskinAudioNoiseSeed();
+  if (seed == 0) {
+    return;
+  }
+  for (size_t i = 0; i < values.size(); ++i) {
+    const uint32_t hash = MoltskinAudioNoiseHash(seed, i, 0x101U);
+    const int value =
+        static_cast<int>(values[i]) + static_cast<int>(hash % 3U) - 1;
+    values[i] = static_cast<unsigned char>(
+        value < 0 ? 0 : (value > 255 ? 255 : value));
+  }
+}
