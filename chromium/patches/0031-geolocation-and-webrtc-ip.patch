+void RTCPeerConnection::ApplyMoltskinCandidatesToDescriptions() {
+  if (moltskin_injected_candidate_block_.empty()) {
+    return;
+  }
+  const std::string block = moltskin_injected_candidate_block_.Utf8();
+  const std::string ip = moltskin_injected_public_ip_.Utf8();
+  for (RTCSessionDescription* desc :
+       {pending_local_description_.Get(), current_local_description_.Get()}) {
+    if (!desc) {
+      continue;
+    }
+    std::string ufrag;
+    std::string mid;
+    const std::string current_sdp = desc->sdp().Utf8();
+    if (ExtractFirstMediaUfragAndMid(current_sdp, &ufrag, &mid) &&
+        ufrag == moltskin_injected_ufrag_.Utf8()) {
+      desc->setSdp(
+          String::FromUtf8(InjectCandidateBlockIntoSdp(current_sdp, block, ip)));
+    }
+  }
