+      const size_t pos = cand.find(addr);
+      if (pos != std::string::npos) {
+        cand.replace(pos, addr.size(), public_ip);
+        platform_candidate = MakeGarbageCollected<RTCIceCandidatePlatform>(
+            String::FromUtf8(cand), platform_candidate->SdpMid(),
+            platform_candidate->SdpMLineIndex(),
+            platform_candidate->UsernameFragment(), platform_candidate->Url());
+      }
+      moltskin_emitted_webrtc_candidates_ = true;
+    } else if (type == "srflx") {
+      moltskin_emitted_webrtc_candidates_ = true;
