+void RTCPeerConnection::MaybeEmitMoltskinIceCandidates() {
+  const std::string& public_ip = MoltskinConfiguredWebrtcPublicIp();
+  if (public_ip.empty() || moltskin_emitted_webrtc_candidates_ || !peer_handler_ ||
+      are_ice_candidates_administratively_prohibited_) {
+    return;
+  }
+  const auto& config = peer_handler_->GetConfiguration();
+  if (config.type == webrtc::PeerConnectionInterface::kRelay) {
+    return;
+  }
+  RTCSessionDescription* local = localDescription();
+  if (!local) {
+    return;
+  }
+  std::string ufrag;
+  std::string mid;
+  if (!ExtractFirstMediaUfragAndMid(local->sdp().Utf8(), &ufrag, &mid)) {
+    return;
+  }
+
+  std::string stun_url;
+  for (const auto& server : config.servers) {
+    for (const auto& url : server.urls) {
+      if (!url.empty()) {
+        stun_url = url;
+        break;
+      }
+    }
+    if (!stun_url.empty()) {
+      break;
+    }
+  }
+
+  const uint32_t seed = MoltskinWebrtcSeed();
+  const size_t h1 = base::FastHash(
+      base::StringPrintf("%u:host:%s", seed, ufrag.c_str()));
+  const size_t h2 = base::FastHash(
+      base::StringPrintf("%u:srflx:%s:%s", seed, public_ip.c_str(), ufrag.c_str()));
+  const uint32_t f_host = 1000000000u + static_cast<uint32_t>(h1 % 3000000000u);
+  const uint32_t f_srflx = 1000000000u + static_cast<uint32_t>(h2 % 3000000000u);
+  const uint16_t port =
+      static_cast<uint16_t>(49152u + static_cast<uint32_t>((h2 >> 16) % 16383u));
+
+  const std::string host_cand = base::StringPrintf(
+      "candidate:%u 1 udp 2122260223 %s %u typ host generation 0 ufrag %s "
+      "network-cost 999",
+      f_host, MoltskinMdnsHostname().c_str(), static_cast<unsigned>(port),
+      ufrag.c_str());
+
+  std::string sdp_block = "a=" + host_cand + "\r\n";
+  std::string srflx_cand;
+  if (!stun_url.empty()) {
+    const char* raddr =
+        (public_ip.find(':') != std::string::npos) ? "::" : "0.0.0.0";
+    srflx_cand = base::StringPrintf(
+        "candidate:%u 1 udp 1686052607 %s %u typ srflx raddr %s rport 0 "
+        "generation 0 ufrag %s network-cost 999",
+        f_srflx, public_ip.c_str(), static_cast<unsigned>(port), raddr,
+        ufrag.c_str());
+    sdp_block += "a=" + srflx_cand + "\r\n";
+  }
+  sdp_block += "a=end-of-candidates\r\n";
+
+  moltskin_emitted_webrtc_candidates_ = true;
+  moltskin_injected_ufrag_ = String::FromUtf8(ufrag);
+  moltskin_injected_candidate_block_ = String::FromUtf8(sdp_block);
+  moltskin_injected_public_ip_ =
+      !stun_url.empty() ? String::FromUtf8(public_ip) : String();
+
+  auto* host_platform = MakeGarbageCollected<RTCIceCandidatePlatform>(
+      String::FromUtf8(host_cand), String::FromUtf8(mid), uint16_t{0},
+      String::FromUtf8(ufrag), String());
+  ScheduleDispatchEvent(
+      RTCPeerConnectionIceEvent::Create(RTCIceCandidate::Create(host_platform)),
+      BindOnce(
+          [](RTCPeerConnection* self) {
+            self->ApplyMoltskinCandidatesToDescriptions();
+            return true;
+          },
+          WrapPersistent(this)));
+
+  if (!srflx_cand.empty()) {
+    auto* srflx_platform = MakeGarbageCollected<RTCIceCandidatePlatform>(
+        String::FromUtf8(srflx_cand), String::FromUtf8(mid), uint16_t{0},
+        String::FromUtf8(ufrag), String::FromUtf8(stun_url));
+    ScheduleDispatchEvent(RTCPeerConnectionIceEvent::Create(
+        RTCIceCandidate::Create(srflx_platform)));
+  }
+}
