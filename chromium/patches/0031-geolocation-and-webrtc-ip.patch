+const std::string& MoltskinConfiguredWebrtcPublicIp() {
+  static const base::NoDestructor<std::string> kPublicIp([]() -> std::string {
+    const auto* cmd = base::CommandLine::ForCurrentProcess();
+    if (!cmd || !cmd->HasSwitch(switches::kMoltskinWebrtcPublicIp)) {
+      return std::string();
+    }
+    std::string raw =
+        cmd->GetSwitchValueASCII(switches::kMoltskinWebrtcPublicIp);
+    base::TrimWhitespaceASCII(raw, base::TRIM_ALL, &raw);
+    if (raw.empty() || raw.size() > 45) {
+      return std::string();
+    }
+    for (unsigned char ch : raw) {
+      if (!base::IsHexDigit(ch) && ch != '.' && ch != ':') {
+        return std::string();
+      }
+    }
+    webrtc::SocketAddress sock(raw, 9);
+    if (sock.IsNil() || sock.IsUnresolvedIP()) {
+      return std::string();
+    }
+    return sock.HostAsURIString();
+  }());
+  return *kPublicIp;
+}
+
+uint32_t MoltskinWebrtcSeed() {
+  static const uint32_t kSeed = []() -> uint32_t {
+    const auto* cmd = base::CommandLine::ForCurrentProcess();
+    uint32_t parsed = 0;
+    if (cmd && cmd->HasSwitch(switches::kMoltskinHardwareSeed) &&
+        base::StringToUint(
+            cmd->GetSwitchValueASCII(switches::kMoltskinHardwareSeed),
+            &parsed) &&
+        parsed != 0) {
+      return parsed;
+    }
+    return 0x6d6f6c74u;
+  }();
+  return kSeed;
+}
+
+const std::string& MoltskinMdnsHostname() {
+  static const base::NoDestructor<std::string> kHost([]() -> std::string {
+    const base::UnguessableToken token = base::UnguessableToken::Create();
+    const uint64_t hi = token.GetHighForSerialization();
+    const uint64_t lo = token.GetLowForSerialization();
+    const uint32_t a = static_cast<uint32_t>(hi >> 32);
+    const uint16_t b = static_cast<uint16_t>((hi >> 16) & 0xffffu);
+    const uint16_t c =
+        static_cast<uint16_t>(((hi & 0x0fffu) | 0x4000u) & 0xffffu);
+    const uint16_t d = static_cast<uint16_t>(
+        (((lo >> 48) & 0x3fffu) | 0x8000u) & 0xffffu);
+    const uint64_t e = lo & 0x0000ffffffffffffULL;
+    return base::StringPrintf("%08x-%04x-%04x-%04x-%012llx.local", a, b, c, d,
+                              static_cast<unsigned long long>(e));
+  }());
+  return *kHost;
+}
+
+bool ExtractFirstMediaUfragAndMid(const std::string& sdp,
+                                  std::string* out_ufrag,
+                                  std::string* out_mid) {
+  bool seen_media = false;
+  std::string session_ufrag;
+  std::string media_ufrag;
+  std::string mid = "0";
+  for (std::string_view raw_line :
+       base::SplitStringPiece(sdp, "\n", base::KEEP_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    std::string_view line =
+        base::TrimWhitespaceASCII(raw_line, base::TRIM_TRAILING);
+    if (base::StartsWith(line, "m=")) {
+      if (seen_media) {
+        break;
+      }
+      seen_media = true;
+      continue;
+    }
+    if (base::StartsWith(line, "a=ice-ufrag:")) {
+      const std::string val(line.substr(12));
+      if (seen_media && media_ufrag.empty()) {
+        media_ufrag = val;
+      } else if (!seen_media && session_ufrag.empty()) {
+        session_ufrag = val;
+      }
+    } else if (seen_media && base::StartsWith(line, "a=mid:")) {
+      mid = std::string(line.substr(6));
+    }
+  }
+  if (!seen_media) {
+    return false;
+  }
+  *out_ufrag = !media_ufrag.empty() ? media_ufrag : session_ufrag;
+  *out_mid = mid.empty() ? "0" : mid;
+  return !out_ufrag->empty();
+}
+
+std::string InjectCandidateBlockIntoSdp(const std::string& sdp,
+                                        const std::string& candidate_block,
+                                        const std::string& public_ip) {
+  if (sdp.find(candidate_block) != std::string::npos) {
+    return sdp;
+  }
+  const bool is_ipv6 = public_ip.find(':') != std::string::npos;
+  std::string out;
+  out.reserve(sdp.size() + candidate_block.size() + 64);
+  bool in_first_media = false;
+  bool injected = false;
+  for (std::string_view raw_line :
+       base::SplitStringPiece(sdp, "\n", base::KEEP_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    std::string_view line =
+        base::TrimWhitespaceASCII(raw_line, base::TRIM_TRAILING);
+    if (base::StartsWith(line, "m=")) {
+      if (in_first_media && !injected) {
+        out.append(candidate_block);
+        injected = true;
+      }
+      in_first_media = !injected;
+    } else if (in_first_media && !public_ip.empty() &&
+               (line == "c=IN IP4 0.0.0.0" || line == "c=IN IP6 ::")) {
+      out.append(is_ipv6 ? "c=IN IP6 " : "c=IN IP4 ");
+      out.append(public_ip);
+      out.append("\r\n");
+      continue;
+    }
+    out.append(line);
+    out.append("\r\n");
+  }
+  if (in_first_media && !injected) {
+    out.append(candidate_block);
+  }
+  return out;
+}
