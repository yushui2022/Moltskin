# Baseline for native Linux x86-64 and macOS arm64 builds.
is_debug = false
symbol_level = 0

# Internal distribution builds enable H.264/AAC so sites such as TikTok,
# Instagram and Amazon behave like Chrome. Set both to false for a
# patent-policy-clean open-source build.
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# Ship release builds without Blink's development DCHECKs. Without this,
# is_debug=false still compiles dcheck_always_on=true in non-official GN.
dcheck_always_on = false
